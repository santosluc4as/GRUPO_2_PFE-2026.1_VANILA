/* 
  Tokens de Design — Site ACBrasil
  Baseado no layout do Figma (Ap1)
*/

/* =========================
   CORES
========================= */

:root {
  --cor-primaria: #0d4a8a;
  --cor-secundaria: #1e293b;
  --cor-destaque: #FDB913;

  --cor-texto: #222222;
  --cor-texto-suave: #666666;

  --cor-fundo: #ffffff;
  --cor-fundo-secundario: #f5f5f5;

  --cor-borda: #dddddd;

  --cor-sucesso: #16a34a;
  --cor-aviso: #f59e0b;
  --cor-erro: #dc2626;
}


/* =========================
   TIPOGRAFIA
========================= */

:root {
  --fonte-principal: "Inter", sans-serif;
  --fonte-titulos: "Playfair Display", serif;

  --tamanho-texto-pequeno: 0.875rem;
  --tamanho-texto-base: 1rem;
  --tamanho-texto-grande: 1.25rem;

  --peso-normal: 400;
  --peso-medio: 500;
  --peso-negrito: 700;

  --altura-linha: 1.5;
}


/* =========================
   ESPAÇAMENTO
========================= */

:root {
  --espacamento-1: 4px;
  --espacamento-2: 8px;
  --espacamento-3: 16px;
  --espacamento-4: 24px;
  --espacamento-5: 32px;
}


/* =========================
   BORDAS E SOMBRAS
========================= */

:root {
  --borda-arredondada: 8px;
  --borda-arredondada-grande: 16px;

  --sombra-suave: 0 2px 8px rgb(0 0 0 / 0.08);
}


/* =========================
   LAYOUT
========================= */

:root {
  --largura-maxima: 1200px;

  --altura-cabecalho: 80px;

  --padding-secao: var(--espacamento-5);
}
