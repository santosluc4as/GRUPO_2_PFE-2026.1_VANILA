/* ======================================
   STYLES.CSS — Newsletter ACBrasil
   Estilos específicos da página
   ====================================== */

/* =========================
   RESET E BASE
========================= */

*,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: var(--fonte-principal);
  font-size: var(--tamanho-texto-base);
  color: var(--cor-texto);
  background-color: var(--cor-fundo);
  line-height: var(--altura-linha);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

a {
  text-decoration: none;
  color: inherit;
}

ul, ol {
  list-style: none;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

button {
  cursor: pointer;
  border: none;
  background: none;
  font-family: inherit;
}

input {
  font-family: inherit;
}


/* =========================
   BARRA DE TOPO
========================= */

.top-bar {
  background-color: var(--cor-destaque);
  text-align: center;
  padding: 10px var(--espacamento-3);
}

.top-bar__link {
  font-size: 0.75rem;
  font-weight: var(--peso-negrito);
  color: var(--cor-secundaria);
  letter-spacing: 1.5px;
  text-transform: uppercase;
  transition: opacity 0.3s ease;
}

.top-bar__link:hover {
  opacity: 0.75;
}

.top-bar__arrow {
  margin-left: 6px;
}


/* =========================
   HEADER / NAVEGAÇÃO
========================= */

.header {
  background-color: var(--cor-secundaria);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
}

.header__container {
  max-width: var(--largura-maxima);
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--espacamento-4);
  height: var(--altura-cabecalho);
}

.header__logo-img {
  height: 48px;
  width: auto;
}

.header__nav-list {
  display: flex;
  gap: var(--espacamento-4);
  align-items: center;
}

.header__nav-link {
  color: #ffffff;
  font-size: 0.875rem;
  font-weight: var(--peso-medio);
  letter-spacing: 0.5px;
  padding: 8px 0;
  position: relative;
  transition: color 0.3s ease;
}

.header__nav-link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 2px;
  background-color: var(--cor-destaque);
  transition: width 0.3s ease;
}

.header__nav-link:hover::after,
.header__nav-link--active::after {
  width: 100%;
}

.header__nav-link--active {
  color: var(--cor-destaque);
}

/* Botão Hambúrguer (Mobile) */
.header__menu-toggle {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 30px;
  height: 30px;
  z-index: 101;
}

.header__menu-toggle span {
  display: block;
  width: 100%;
  height: 2px;
  background-color: #ffffff;
  border-radius: 2px;
  transition: transform 0.3s ease, opacity 0.3s ease;
}

.header__menu-toggle.active span:nth-child(1) {
  transform: rotate(45deg) translate(5px, 5px);
}
.header__menu-toggle.active span:nth-child(2) {
  opacity: 0;
}
.header__menu-toggle.active span:nth-child(3) {
  transform: rotate(-45deg) translate(5px, -5px);
}


/* =========================
   HERO
========================= */

.hero {
  background-color: var(--cor-secundaria);
  padding: 60px var(--espacamento-4) 80px;
  text-align: left;
}

.hero__container {
  max-width: var(--largura-maxima);
  margin: 0 auto;
}

.hero__breadcrumb {
  font-size: 0.75rem;
  color: rgba(255, 255, 255, 0.5);
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-bottom: var(--espacamento-3);
}

.hero__title {
  font-family: var(--fonte-titulos);
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: var(--peso-negrito);
  color: #ffffff;
  line-height: 1.15;
  margin-bottom: var(--espacamento-3);
}

.hero__title--highlight {
  color: var(--cor-destaque);
}

.hero__subtitle {
  font-size: 1.05rem;
  color: rgba(255, 255, 255, 0.7);
  max-width: 600px;
  line-height: 1.6;
}


/* =========================
   TÓPICOS CURADOS
========================= */

.curated {
  padding: 60px var(--espacamento-4);
  background-color: var(--cor-fundo);
}

.curated__container {
  max-width: var(--largura-maxima);
  margin: 0 auto;
}

/* Grid de 3 cards superiores */
.curated__grid-top {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--espacamento-4);
  margin-bottom: var(--espacamento-5);
}

.curated__card {
  background-color: var(--cor-secundaria);
  border-radius: var(--borda-arredondada);
  padding: var(--espacamento-5) var(--espacamento-4);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 200px;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.curated__card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
}

.curated__card--highlight {
  background-color: var(--cor-destaque);
}

.curated__tag {
  font-size: 0.65rem;
  font-weight: var(--peso-negrito);
  color: var(--cor-destaque);
  letter-spacing: 2px;
  text-transform: uppercase;
  margin-bottom: var(--espacamento-3);
}

.curated__card-title {
  font-family: var(--fonte-titulos);
  font-size: 1.15rem;
  font-weight: var(--peso-negrito);
  color: #ffffff;
  line-height: 1.4;
  margin-bottom: var(--espacamento-4);
}

.curated__card-title--dark {
  color: var(--cor-secundaria);
}

.curated__card-link {
  font-size: 0.75rem;
  font-weight: var(--peso-negrito);
  color: var(--cor-destaque);
  letter-spacing: 1.5px;
  text-transform: uppercase;
  transition: opacity 0.3s ease;
}

.curated__card-link:hover {
  opacity: 0.7;
}

.curated__card-link--dark {
  color: var(--cor-secundaria);
}

/* Card de destaque com imagem */
.curated__feature {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--espacamento-4);
  background-color: var(--cor-fundo-secundario);
  border-radius: var(--borda-arredondada);
  overflow: hidden;
}

.curated__feature-image {
  position: relative;
  min-height: 280px;
}

.curated__feature-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #c9d6e3, #a8b8ca);
  position: absolute;
  top: 0;
  left: 0;
}

.curated__feature-content {
  padding: var(--espacamento-5) var(--espacamento-4);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.curated__feature-title {
  font-family: var(--fonte-titulos);
  font-size: 1.5rem;
  font-weight: var(--peso-negrito);
  color: var(--cor-texto);
  line-height: 1.35;
  margin-bottom: var(--espacamento-3);
}

.curated__feature-desc {
  font-size: 0.95rem;
  color: var(--cor-texto-suave);
  line-height: 1.6;
  margin-bottom: var(--espacamento-4);
}

.curated__feature-tags {
  display: flex;
  gap: var(--espacamento-2);
}

.curated__feature-tag {
  font-size: 0.7rem;
  font-weight: var(--peso-negrito);
  letter-spacing: 1px;
  padding: 6px 14px;
  border-radius: 4px;
  background-color: var(--cor-secundaria);
  color: #ffffff;
}


/* =========================
   ARQUIVO DE NOTÍCIAS
========================= */

.archive {
  padding: 60px var(--espacamento-4) 80px;
  background-color: var(--cor-fundo);
}

.archive__container {
  max-width: var(--largura-maxima);
  margin: 0 auto;
}

.archive__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 40px;
  flex-wrap: wrap;
  gap: var(--espacamento-4);
}

.archive__title {
  font-family: var(--fonte-titulos);
  font-size: 1.75rem;
  font-weight: var(--peso-negrito);
  color: var(--cor-texto);
  margin-bottom: 6px;
}

.archive__subtitle {
  font-size: 0.9rem;
  color: var(--cor-texto-suave);
}

.archive__controls {
  display: flex;
  align-items: center;
  gap: var(--espacamento-4);
}

/* Paginação */
.archive__pagination {
  display: flex;
  gap: 4px;
}

.archive__page-btn {
  width: 32px;
  height: 32px;
  border-radius: 6px;
  font-size: 0.8rem;
  font-weight: var(--peso-medio);
  color: var(--cor-texto-suave);
  background-color: var(--cor-fundo-secundario);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
}

.archive__page-btn:hover {
  background-color: var(--cor-secundaria);
  color: #ffffff;
}

.archive__page-btn--active {
  background-color: var(--cor-secundaria);
  color: #ffffff;
}

.archive__page-btn--arrow {
  background-color: var(--cor-destaque);
  color: var(--cor-secundaria);
  font-weight: var(--peso-negrito);
}

/* Busca */
.archive__search {
  position: relative;
}

.archive__search-input {
  padding: 10px 40px 10px 16px;
  border: 1px solid var(--cor-borda);
  border-radius: var(--borda-arredondada);
  font-size: 0.85rem;
  color: var(--cor-texto);
  background-color: var(--cor-fundo);
  width: 220px;
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

.archive__search-input::placeholder {
  color: var(--cor-texto-suave);
}

.archive__search-input:focus {
  outline: none;
  border-color: var(--cor-secundaria);
  box-shadow: 0 0 0 3px rgba(30, 41, 59, 0.1);
}

.archive__search-icon {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--cor-texto-suave);
  pointer-events: none;
}

/* Grid de Cards */
.archive__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--espacamento-4);
}

.archive__card {
  background-color: var(--cor-fundo);
  border-radius: var(--borda-arredondada);
  overflow: hidden;
  border: 1px solid var(--cor-borda);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.archive__card:hover {
  transform: translateY(-4px);
  box-shadow: var(--sombra-suave);
}

.archive__card-info {
  padding: var(--espacamento-4);
}

.archive__edition {
  font-size: 0.7rem;
  font-weight: var(--peso-negrito);
  color: var(--cor-secundaria);
  letter-spacing: 1.5px;
  text-transform: uppercase;
  display: block;
  margin-bottom: var(--espacamento-2);
}

.archive__card-title {
  font-family: var(--fonte-titulos);
  font-size: 1rem;
  font-weight: var(--peso-negrito);
  color: var(--cor-texto);
  line-height: 1.4;
  margin-bottom: var(--espacamento-2);
}

.archive__date {
  font-size: 0.7rem;
  color: var(--cor-texto-suave);
  letter-spacing: 1px;
  text-transform: uppercase;
}

.archive__card-image {
  position: relative;
  padding-top: 56.25%; /* 16:9 aspect ratio */
}

.archive__card-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #c9d6e3, #8fa4b8);
}


/* =========================
   INSCRIÇÃO NA NEWSLETTER
========================= */

.newsletter-subscribe {
  position: relative;
  background: linear-gradient(135deg, #2c3e50, #3a506b);
  min-height: 320px;
}

.newsletter-subscribe__overlay {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 320px;
  padding: 60px var(--espacamento-4);
  background: rgba(0, 0, 0, 0.35);
}

.newsletter-subscribe__container {
  text-align: center;
  max-width: 700px;
}

.newsletter-subscribe__title {
  font-family: var(--fonte-titulos);
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: var(--peso-negrito);
  color: #ffffff;
  margin-bottom: var(--espacamento-5);
  line-height: 1.3;
}

.newsletter-subscribe__form {
  display: flex;
  gap: var(--espacamento-2);
  justify-content: center;
  flex-wrap: wrap;
}

.newsletter-subscribe__input {
  padding: 14px 20px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-radius: var(--borda-arredondada);
  font-size: 0.95rem;
  color: #ffffff;
  background-color: rgba(255, 255, 255, 0.1);
  min-width: 280px;
  transition: border-color 0.3s ease, background-color 0.3s ease;
}

.newsletter-subscribe__input::placeholder {
  color: rgba(255, 255, 255, 0.6);
}

.newsletter-subscribe__input:focus {
  outline: none;
  border-color: var(--cor-destaque);
  background-color: rgba(255, 255, 255, 0.15);
}

.newsletter-subscribe__btn {
  padding: 14px 28px;
  background-color: var(--cor-secundaria);
  color: #ffffff;
  font-size: 0.8rem;
  font-weight: var(--peso-negrito);
  letter-spacing: 1.5px;
  border-radius: var(--borda-arredondada);
  border: none;
  transition: background-color 0.3s ease, transform 0.2s ease;
}

.newsletter-subscribe__btn:hover {
  background-color: #0f172a;
  transform: translateY(-2px);
}

.newsletter-subscribe__btn:active {
  transform: translateY(0);
}


/* =========================
   FOOTER
========================= */

.footer {
  background-color: var(--cor-secundaria);
  padding: 60px var(--espacamento-4) 0;
  color: rgba(255, 255, 255, 0.7);
}

.footer__container {
  max-width: var(--largura-maxima);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1.5fr;
  gap: var(--espacamento-5);
  padding-bottom: 40px;
}

.footer__logo {
  height: 40px;
  width: auto;
  margin-bottom: var(--espacamento-3);
}

.footer__desc {
  font-size: 0.85rem;
  line-height: 1.7;
  margin-bottom: var(--espacamento-4);
  max-width: 300px;
}

.footer__social {
  display: flex;
  gap: var(--espacamento-3);
}

.footer__social-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.1);
  color: #ffffff;
  transition: background-color 0.3s ease, transform 0.2s ease;
}

.footer__social-link:hover {
  background-color: var(--cor-destaque);
  color: var(--cor-secundaria);
  transform: translateY(-2px);
}

.footer__col-title {
  font-size: 0.75rem;
  font-weight: var(--peso-negrito);
  color: #ffffff;
  letter-spacing: 2px;
  margin-bottom: var(--espacamento-4);
}

.footer__links {
  display: flex;
  flex-direction: column;
  gap: var(--espacamento-2);
}

.footer__link {
  font-size: 0.85rem;
  color: rgba(255, 255, 255, 0.6);
  transition: color 0.3s ease;
}

.footer__link:hover {
  color: var(--cor-destaque);
}

.footer__links--contact li {
  display: flex;
  align-items: center;
  gap: var(--espacamento-2);
}

.footer__links--contact svg {
  flex-shrink: 0;
  color: var(--cor-destaque);
}

.footer__bottom {
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  padding: 20px 0;
  text-align: center;
}

.footer__bottom p {
  font-size: 0.75rem;
  color: rgba(255, 255, 255, 0.4);
  letter-spacing: 1px;
}


/* =========================
   RESPONSIVE (MOBILE)
========================= */

@media (max-width: 992px) {
  .curated__grid-top {
    grid-template-columns: 1fr;
  }

  .curated__feature {
    grid-template-columns: 1fr;
  }

  .curated__feature-image {
    min-height: 200px;
  }

  .archive__grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .archive__header {
    flex-direction: column;
    align-items: flex-start;
  }

  .footer__container {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 768px) {
  .header__menu-toggle {
    display: flex;
  }

  .header__nav {
    position: fixed;
    top: 0;
    right: -100%;
    width: 280px;
    height: 100vh;
    background-color: var(--cor-secundaria);
    padding: 100px var(--espacamento-4) var(--espacamento-4);
    transition: right 0.4s ease;
    box-shadow: -4px 0 20px rgba(0, 0, 0, 0.3);
    z-index: 100;
  }

  .header__nav.open {
    right: 0;
  }

  .header__nav-list {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--espacamento-3);
  }

  .hero__title {
    font-size: 2rem;
  }

  .archive__grid {
    grid-template-columns: 1fr;
  }

  .archive__controls {
    flex-direction: column;
    align-items: flex-start;
  }

  .newsletter-subscribe__form {
    flex-direction: column;
    align-items: center;
  }

  .newsletter-subscribe__input {
    min-width: 100%;
  }

  .footer__container {
    grid-template-columns: 1fr;
    gap: var(--espacamento-4);
  }
}
